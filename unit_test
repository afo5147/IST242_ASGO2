"""
Testing personal library
"""
# Python libraries imported for testing
import unittest
from unittest.mock import patch
from io import StringIO

# Import our user made functions for testing
from personal_library import (
    add_book,
    list_books,
    search_books,
    remove_book,
    #update_book,
    #statistic,
    #save_library,
    #uploading_library
)
# Test class
class TestPersonalLibrary(unittest.TestCase):

    # Test case for add_book function
    @patch("builtins.input", side_effect=["Arknis", "Thuan Nguyen", "2026"])
    def test_add_book_normal_case(self, mock_input):
        library = {}
        add_book(library)
        self.assertIn("Arknis", library)
        self.assertEqual(library["Arknis"]["author"], "Thuan Nguyen")
        self.assertEqual(library["Arknis"]["year"], 2026)


    def test_view_book_output(self):
        library = {
            "Arknis": {"author": "Thuan Nguyen", "year": 2026}
        }
        with patch("sys.stdout", new=StringIO()) as fake_out:
            list_books(library)
            output = fake_out.getvalue()

        self.assertIn("Arknis", output)
        self.assertIn("Thuan Nguyen", output)
        self.assertIn("2026", output)


    @patch("builtins.input", return_value="rk")
    def test_search_book(self, mock_input):
        library = {
            "Arknis": {"author": "Thuan Nguyen", "year": 2026}
        }

        with patch("sys.stdout", new=StringIO()) as fake_out:
            search_books(library)
            output = fake_out.getvalue()

        self.assertIn("Arknis", output)


    @patch("builtins.input", return_value="Arknis")
    def test_delete_book(self, mock_input):
        library = {
            "Arknis": {"author": "Thuan Nguyen", "year": 2026}
        }

        remove_book(library)
        self.assertNotIn("Arknis", library)
    

# Call the test case main method
if __name__ == "__main__":
    unittest.main()
